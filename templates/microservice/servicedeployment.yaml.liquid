apiVersion: deployments.plural.sh/v1alpha1
kind: ServiceDeployment
metadata:
  name: {{ context.name }}-{{ context.environment }}
  namespace: gitops-example
spec:
  namespace: {{ context.name }}
  name: {{ context.name }}-{{ context.environment }}
  flowRef:
    name: {{ context.name }}
    namespace: gitops-example
  repositoryRef:
    kind: GitRepository
    name: gitops-example
    namespace: infra
  git:
    ref: main
    folder: deployments/helm/{{ context.name }}
  helm:
    url: oci://ghcr.io/pluralsh/example-charts
    chart: stateless
    valuesFiles:
      - base.yaml
      - {{ context.environment }}.yaml
  cluster: {{ context.cluster }}
