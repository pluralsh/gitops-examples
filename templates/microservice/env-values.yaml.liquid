replicaCount: 1

image:
  tag: "{{ context.tag }}"

ingress:
  enabled: true
  className: nginx
  annotations:
    kubernetes.io/tls-acme: "true"
    cert-manager.io/cluster-issuer: letsencrypt-prod
  hosts:
    - host: "{{ context.domain }}"
      paths:
        - path: /
          pathType: Prefix
  tls:
    - secretName: {{ context.name }}-{{ context.environment }}-tls
      hosts:
        - "{{ context.domain }}"

podLabels:
  plural.sh/environment: "{{ context.environment }}"
